{
  "name": "taskboard",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "taskboard",
      "version": "1.0.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@taskboard/api",
      "version": "1.0.0",
      "dependencies": {
        "@taskboard/shared": "*"
      }
    },
    "apps/web": {
      "name": "@taskboard/web",
      "version": "1.0.0"
    },
    "node_modules/@taskboard/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@taskboard/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@taskboard/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@taskboard/shared",
      "version": "1.0.0"
    }
  }
}
